{
  "name": "@genpath/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GenPath AI REST API and background worker.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "dev:worker": "tsx watch --clear-screen=false src/worker.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:validate": "tsx src/scripts/validate-content.ts",
    "seed": "tsx src/scripts/seed.ts",
    "create-admin": "tsx src/scripts/create-admin.ts",
    "exercises:verify": "tsx src/scripts/verify-exercises.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@genpath/ai-core": "workspace:^",
    "@genpath/shared": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "bullmq": "^5.81.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "jose": "^6.2.12",
    "mammoth": "^1.13.0",
    "mongoose": "^9.11.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.16",
    "pino": "^10.0.0",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.1",
    "unpdf": "^1.8.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.18.0",
    "@types/supertest": "^6.0.3",
    "pino-pretty": "^13.1.1",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "vitest": "4.1.11"
  }
}
