# ─────────────────────────────────────────────────────────────────────────────
# GenPath AI — environment configuration
# Copy to `.env` (never commit `.env`). The API validates everything at startup
# and prints a list of problems if something is missing or invalid.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info

# Web app origin (used for CORS, CSRF origin checks and email links)
WEB_URL=http://localhost:3000
# Where the Next.js server proxies /api/v1/* (server-side only)
API_URL=http://localhost:4000
PORT=4000
# Extra allowed origins for direct API access, comma-separated (optional)
CORS_ORIGINS=
# Express "trust proxy" setting. Local dev: requests arrive via the Next.js proxy on loopback.
TRUST_PROXY=loopback
# Multiplies every rate limit (e.g. 20 for local load or E2E testing). Keep 1 in production.
RATE_LIMIT_MULTIPLIER=1
# Curriculum content directory (defaults to <repo>/content)
CONTENT_DIR=

# ── Database ────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/genpath_ai
# Build indexes automatically on startup (defaults to true outside production)
MONGODB_AUTO_INDEX=

# ── Redis (optional in development, required in production) ─────────────────
# Without Redis: in-memory rate limits and an in-process job runner (single instance only).
REDIS_URL=

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=30
# Defaults to true in production. Keep false for http://localhost.
COOKIE_SECURE=

# ── Email ───────────────────────────────────────────────────────────────────
# log  = write verification/reset links to the API log (development only)
# smtp = send through SMTP_URL, e.g. smtps://user:pass@smtp.example.com:465
MAIL_TRANSPORT=log
SMTP_URL=
MAIL_FROM=GenPath AI <no-reply@genpath.local>

# ── AI provider ─────────────────────────────────────────────────────────────
# none              = AI features show a configuration guide
# mock              = deterministic mock responses, tagged "Mock AI" (not allowed in production)
# openai-compatible = OpenAI, Ollama, OpenRouter, Groq, LM Studio, vLLM… (set AI_BASE_URL for non-OpenAI)
# anthropic         = Anthropic Messages API
# gemini            = Google Gemini API
AI_PROVIDER=none
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
AI_FALLBACK_MODEL=
AI_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=1500
AI_MAX_INPUT_CHARS=8000
# Per-user AI requests per day (0 disables AI for learners)
AI_DAILY_REQUEST_LIMIT=100
# Anthropic only: let the API retry a declined request on its default fallback model, for models that
# support server-side fallback. Set to false to disable.
AI_ANTHROPIC_SERVER_FALLBACK=true
# Prices for cost estimates, USD per 1M tokens, for models GenPath has no verified price for:
#   AI_PRICING_JSON={"llama3.2":{"input":0,"output":0},"my-model":{"input":0.5,"output":1.5}}
# Requests for models without a known price are counted but shown as "unpriced" (never guessed).
AI_PRICING_JSON=

# Example — free local model with Ollama:
#   AI_PROVIDER=openai-compatible
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_MODEL=llama3.2

# ── Embeddings ──────────────────────────────────────────────────────────────
# local-hash = deterministic, offline, LEXICAL (word overlap) — labelled in the UI
# openai-compatible / gemini = real semantic embeddings
AI_EMBEDDING_PROVIDER=local-hash
AI_EMBEDDING_MODEL=
# Defaults to AI_API_KEY / AI_BASE_URL only when the embedding provider equals AI_PROVIDER
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_BASE_URL=

# ── Vector search ───────────────────────────────────────────────────────────
# mongodb-local = cosine similarity in the API over tenant-filtered chunks (small corpora)
# atlas         = MongoDB Atlas Vector Search ($vectorSearch)
VECTOR_STORE_PROVIDER=mongodb-local
ATLAS_VECTOR_INDEX_NAME=knowledge_chunks_vector

# ── Object storage (original uploaded documents) ────────────────────────────
OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_LOCAL_DIR=.data/uploads
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
UPLOAD_MAX_BYTES=10485760

# ── Knowledge base (RAG) ────────────────────────────────────────────────────
# Minimum hybrid retrieval score (0–1) for a passage to be used. Empty = 0.25 for local-hash,
# 0.35 for semantic embeddings (an uncalibrated start: tune it with Admin → Retrieval check).
KB_MIN_SCORE=
# Chunking: maximum words per passage and words repeated between neighbouring passages
KB_CHUNK_WORDS=180
KB_CHUNK_OVERLAP_WORDS=30

# ── Tests ───────────────────────────────────────────────────────────────────
# Tests create and drop uniquely named databases on this server.
TEST_MONGODB_URI=mongodb://127.0.0.1:27017
# Set to run the BullMQ queue integration test (skipped otherwise; CI sets it)
TEST_REDIS_URL=
